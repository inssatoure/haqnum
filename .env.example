# Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ID de la mission (créée par supabase/migrations)
NEXT_PUBLIC_MISSION_ID=00000000-0000-4000-8000-000000002026

# Côté serveur uniquement (jamais dans le code)
GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Moteur par défaut : gemini (économique) ou claude
AI_DEFAULT_ENGINE=gemini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optionnel : séparation des voix
PYANNOTE_API_KEY=

# Cloudflare R2 (stockage des fichiers ; sinon Supabase Storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=francxe
